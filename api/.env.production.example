APP_NAME=AppChama
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://SUA-URL.railway.app

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

# MySQL (Railway: copie das variáveis do plugin MySQL)
DB_CONNECTION=mysql
DB_HOST=${MYSQLHOST}
DB_PORT=${MYSQLPORT}
DB_DATABASE=${MYSQLDATABASE}
DB_USERNAME=${MYSQLUSER}
DB_PASSWORD=${MYSQLPASSWORD}

SESSION_DRIVER=database
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Redis (Railway: copie do plugin Redis)
REDIS_CLIENT=predis
REDIS_HOST=${REDISHOST}
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_PORT=${REDISPORT}
REDIS_URL=${REDIS_URL}

# WebSocket desligado no deploy MVP (apps usam polling)
BROADCAST_CONNECTION=log

SMS_PROVIDER=log
DEFAULT_TENANT_SLUG=chama-demo
MAPBOX_ACCESS_TOKEN=

LOG_CHANNEL=stderr
