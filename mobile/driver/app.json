{
  "expo": {
    "name": "Chama Motorista",
    "slug": "chama-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "chama-driver",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#14213D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.appchama.driver"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14213D"
      },
      "package": "com.appchama.driver"
    },
    "web": {
      "bundler": "metro",
      "name": "Chama Motorista"
    },
    "extra": {
      "eas": {
        "projectId": "driver-local"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Precisamos da sua localização para receber corridas próximas."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ]
  }
}
