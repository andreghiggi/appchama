{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {},
    "vaide55": {
      "extends": "base",
      "env": {
        "MARCA": "vaide55"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production"
    },
    "vaide55-teste": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "MARCA": "vaide55"
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "preview"
    },
    "appchama": {
      "extends": "base",
      "env": {
        "MARCA": "appchama"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production"
    },
    "appchama-teste": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "MARCA": "appchama"
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "preview"
    }
  },
  "submit": {
    "producao": {
      "android": {
        "track": "internal"
      }
    }
  }
}
